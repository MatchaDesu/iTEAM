<% 
  const member=[
    ['สมัครสมาชิกและตั้งค่าโปรไฟล์', 'สร้างบัญชีด้วยอีเมล แล้วเพิ่มทักษะและแนะนำตัวในหน้าโปรไฟล์ เพื่อให้หัวหน้าทีมรู้จักคุณมากขึ้น'
    ], ['ค้นหาทีมที่สนใจ', 'พิมพ์ชื่อทีม ตำแหน่ง หรือทักษะในช่องค้นหา และกรองตามหมวดหมู่ได้' ],
    ['ดูรายละเอียด', 'เปิดดูตำแหน่งที่รับ จำนวนสมาชิก และหัวหน้าทีม ' ],
    ['สมัครเข้าร่วมทีม', 'เขียนข้อความแนะนำตัวถึงหัวหน้าทีมแล้วกดสมัคร หากเปลี่ยนใจยกเลิกใบสมัครได้ตราบใดที่ยังรอพิจารณา'
    ], ['ติดตามผลการสมัคร', 'ดูสถานะในหน้า "ใบสมัครของฉัน" และรับแจ้งเตือนเมื่อหัวหน้าทีมตอบรับหรือปฏิเสธ' ] ]; 
  const leader=
    [ ['สร้างทีม', 'กด "สร้างทีมใหม่" กรอกชื่อ หมวดหมู่ รายละเอียด และจำนวนสมาชิกสูงสุด' ],
    ['ตั้งค่าโพสต์รับสมัคร', 'ใส่หัวข้อ ระบุตำแหน่งที่ต้องการ และเปิดรับสมัคร โพสต์จะขึ้นแสดงหลังผู้ดูแลระบบอนุมัติ' ],
    ['ตรวจสอบผู้สมัคร', 'ดูทักษะและข้อความแนะนำตัวของแต่ละคนในแท็บ "ผู้สมัคร"' ],
    ['รับหรือปฏิเสธ', 'กด "รับเข้าทีม" หรือ "ปฏิเสธ" ระบบจะแจ้งผู้สมัครให้อัตโนมัติ' ],
    ['จัดการสมาชิกและข้อมูลทีม', 'แก้ไขรายละเอียดทีม ปิดรับสมัครเมื่อครบ หรือนำสมาชิกออกจากทีมได้' ] ]; 
  const feats=[
    ['ค้นหาและกรองทีม', 'ค้นหาด้วยคำสำคัญ และเลือกดูตามหมวดหมู่ เช่น Hackathon โปรเจกต์มหาวิทยาลัย ' ],
    ['ใบสมัครและติดตามสถานะ', 'รอพิจารณา ได้รับการตอบรับ หรือไม่ผ่าน ดูได้ครบในที่เดียว' ],
    ['ระบบแจ้งเตือน', 'รู้ทันทีเมื่อมีผู้สมัครใหม่ หรือผลการสมัครออกแล้ว' ],
    ['เครื่องมือหัวหน้าทีม', 'จัดการทีม โพสต์ ผู้สมัคร และสมาชิกในหน้าเดียวแบ่งเป็นแท็บ' ],
    ['ผู้ดูแลตรวจสอบโพสต์', 'โพสต์ผ่านการตรวจก่อนแสดง ช่วยให้ทีมและประกาศมีคุณภาพ' ] ]; 
%>


  <section class="hero-lg">
    <span class="pill">iTEAM</span>
    <h1>หาคนที่ใช่ เพื่อสร้างทีมของคุณ</h1>
    <p class="mu">แพลตฟอร์มที่ช่วยให้ผู้สมัครหาทีมที่ใช่ และให้หัวหน้าทีมหาสมาชิกที่ตรงกับโปรเจกต์
      อ่านวิธีใช้ด้านล่างได้เลย</p>
    <div class="acts">
      <a class="btn lg" href="#member">เข้าร่วมโปรเจกต์</a>
      <a class="btn sec lg" href="#leader">สร้างโปรเจกต์</a>
    </div>
  </section>

  <div class="sec-h" id="member">
    <div><span class="tag">สำหรับ Member</span>
      <h2>วิธีเข้าร่วมโปรเจกต์</h2>
    </div>
  </div>
  <div class="steps">
    <% member.forEach(([t, d], i)=> { %>
      <div class="card">
        <div class="num">
          <%= i + 1 %>
        </div>
        <h3>
          <%= t %>
        </h3>
        <div class="mu">
          <%= d %>
        </div>
      </div>
      <% }) %>
  </div>

  <div class="sec-h" id="leader">
    <div><span class="tag">สำหรับ Leader</span>
      <h2>วิธีสร้างโปรเจกต์และรับสมาชิก</h2>
    </div>
  </div>
  <div class="steps">
    <% leader.forEach(([t, d], i)=> { %>
      <div class="card">
        <div class="num">
          <%= i + 1 %>
        </div>
        <h3>
          <%= t %>
        </h3>
        <div class="mu">
          <%= d %>
        </div>
      </div>
      <% }) %>
  </div>

  <div class="sec-h" id="features">
    <div><span class="tag">ฟีเจอร์</span>
      <h2>ฟีเจอร์ของ iTEAM </h2>
    </div>
  </div>
  <div class="steps">
    <% feats.forEach(([t, d])=> { %>
      <div class="card">
        <h3>
          <%= t %>
        </h3>
        <div class="mu">
          <%= d %>
        </div>
      </div>
      <% }) %>
  </div>

  <section class="cta-band" id="start">
    <h2>เริ่มต้นใช้งาน</h2>
    <p>สมัครฟรี แล้วเลือกได้เลยว่าจะหาทีมหรือสร้างทีมของคุณเอง</p>
    <div class="acts" style="justify-content:center">
      <% if (user) { %>
        <a class="btn lg" href="/teams">สำรวจทีม</a>
        <a class="btn lg" href="/leader/teams/new">สร้างทีมใหม่</a>
        <% } else { %>
          <a class="btn lg" href="/auth/signup">สมัครสมาชิกฟรี</a>
          <a class="btn lg" href="/auth/login">เข้าสู่ระบบ</a>
          <a class="btn lg" href="/teams">สำรวจทีม</a>
          <% } %>
    </div>
  </section>