<%
  const catList = locals.categories || locals.cats || [];
%>
<h2>จัดการหมวดหมู่</h2>
<form class="tools" method="post" action="/categories">
  <input name="category_name" maxlength="100" placeholder="ชื่อหมวดหมู่ใหม่" aria-label="หมวดหมู่ใหม่" required>
</form>

<div class="tw">
  <table class="tb">
    <thead>
      <tr>
        <th>ชื่อหมวดหมู่</th>
        <th>จัดการ</th>
      </tr>
    </thead>
    <tbody>
      <% catList.forEach((c, i) => {
        const cId = typeof c === 'object' ? c.category_id : i;
        const cName = typeof c === 'object' ? c.category_name : c;
      %>
        <tr>
          <td>
            <form method="post" action="/categories/<%= cId %>/update" class="tools" style="margin:0">
              <input name="category_name" maxlength="100" value="<%= cName %>" aria-label="ชื่อหมวดหมู่" required>
              <button type="submit" class="btn sec sm">บันทึกชื่อ</button>
            </form>
          </td>
          <td>
            <form method="post" action="/categories/<%= cId %>/delete" onsubmit="return confirm('ลบหมวดหมู่นี้?')">
              <button type="submit" class="btn no sm">ลบ</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!catList.length) { %>
        <tr><td colspan="2" class="mu" style="text-align:center;padding:28px">ยังไม่มีหมวดหมู่</td></tr>
      <% } %>
    </tbody>
  </table>
</div>