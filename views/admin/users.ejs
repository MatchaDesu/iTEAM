<%
  const userList = Array.isArray(locals.users) ? locals.users : [];
  const qText = locals.q || '';
  const roleFilter = locals.role || locals.f || '';
  const curAdminId = locals.user ? (locals.user.user_id ?? locals.user.id) : null;
%>
<h2>จัดการผู้ใช้</h2>
<form class="tools" method="get" action="/admin/users">
  <input name="q" value="<%= qText %>" placeholder="ค้นหาชื่อหรืออีเมล" aria-label="ค้นหา">
  <% [['', 'ทั้งหมด'], ['member', 'สมาชิก'], ['admin', 'ผู้ดูแล']].forEach(([k, n]) => { %>
    <a class="chip <%= roleFilter === k ? 'on' : '' %>" href="/admin/users?role=<%= k %>&q=<%= encodeURIComponent(qText) %>">
      <%= n %>
    </a>
  <% }) %>
</form>

<div class="tw">
  <table class="tb">
    <thead>
      <tr>
        <th>ชื่อ</th>
        <th>ชื่อผู้ใช้</th>
        <th>อีเมล</th>
        <th>เบอร์โทร</th>
        <th>บทบาท</th>
        <th>จัดการสิทธิ์</th>
      </tr>
    </thead>
    <tbody>
      <% userList.forEach(u => {
        const uId = u.user_id ?? u.id;
        const fullName = u.first_name ? `${u.first_name} ${u.last_name || ''}`.trim() : (u.name || '-');
        const nextRole = u.role === 'admin' ? 'member' : 'admin';
      %>
        <tr>
          <td><b><%= fullName %></b></td>
          <td class="mu"><%= u.username ? '@' + u.username : '-' %></td>
          <td class="mu"><%= u.email %></td>
          <td class="mu"><%= u.phone || '-' %></td>
          <td>
            <span class="st <%= u.role === 'admin' ? 'ok' : '' %>">
              <%= u.role === 'admin' ? 'ผู้ดูแล' : 'สมาชิก' %>
            </span>
          </td>
          <td>
            <% if (String(uId) !== String(curAdminId)) { %>
              <form method="post" action="/admin/users/<%= uId %>/role"
                    onsubmit="return confirm('ยืนยันการเปลี่ยนบทบาทผู้ใช้?')">
                <input type="hidden" name="role" value="<%= nextRole %>">
                <button type="submit" class="btn <%= u.role === 'admin' ? 'no' : 'sec' %> sm">
                  <%= u.role === 'admin' ? 'ลดสิทธิ์เป็นสมาชิก' : 'ตั้งเป็นผู้ดูแล' %>
                </button>
              </form>
            <% } else { %>
              <span class="mu" style="font-size:13px">บัญชีปัจจุบัน</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!userList.length) { %>
        <tr><td colspan="6" class="mu" style="text-align:center;padding:28px">ไม่พบผู้ใช้</td></tr>
      <% } %>
    </tbody>
  </table>
</div>