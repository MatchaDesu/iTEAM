<h2>จัดการผู้ใช้</h2>
<form class="tools" method="get">
  <input name="q" value="<%= q %>" placeholder="ค้นหาชื่อหรืออีเมล" aria-label="ค้นหา">
  <% [['','ทั้งหมด'],['a','ใช้งานได้'],['s','ถูกระงับ']].forEach(([k,n])=> { %>
    <a class="chip <%= f===k?'on':'' %>" href="/admin/users?f=<%= k %>&q=<%= encodeURIComponent(q) %>">
      <%= n %>
    </a>
    <% }) %>
</form>
<div class="tw">
  <table class="tb">
    <thead>
      <tr>
        <th>ชื่อ</th>
        <th>อีเมล</th>
        <th>บทบาท</th>
        <th>ทีมที่เป็นหัวหน้า</th>
        <th>ใบสมัคร</th>
        <th>สถานะ</th>
        <th>จัดการ</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u=> { %>
        <tr>
          <td><b>
              <%= u.name %>
            </b></td>
          <td class="mu">
            <%= u.email %>
          </td>
          <td>
            <%= u.role==='admin' ? 'ผู้ดูแล' : 'สมาชิก' %>
          </td>
          <td>
            <%= db.teams.filter(t=> t.leader===u.id).length %>
          </td>
          <td>
            <%= db.apps.filter(a=> a.user===u.id).length %>
          </td>
          <td><span class="st <%= u.suspended?'no':'ok' %>">
              <%= u.suspended ? 'ถูกระงับ' : 'ใช้งานได้' %>
            </span></td>
          <td>
            <% if (u.role !=='admin' ) { %>
              <form method="post" action="/admin/users/<%= u.id %>/suspend"><button
                  class="btn <%= u.suspended?'sec':'no' %> sm">
                  <%= u.suspended ? 'ปลดระงับ' : 'ระงับบัญชี' %>
                </button></form>
              <% } %>
          </td>
        </tr>
        <% }) %>
          <% if (!users.length) { %>
            <tr>
              <td colspan="7" class="mu" style="text-align:center;padding:28px">ไม่พบผู้ใช้</td>
            </tr>
            <% } %>
    </tbody>
  </table>
</div>