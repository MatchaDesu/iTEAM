<%
  const userList = Array.isArray(locals.users) ? locals.users : [];
  const qText = locals.q || '';
  const roleFilter = locals.role || locals.f || '';
  const currentUserId = locals.currentUserId;
%>
<h2>จัดการผู้ใช้</h2>
<form class="tools" method="get" action="/admin/users">
  <input name="q" value="<%= qText %>" placeholder="ค้นหาชื่อหรืออีเมล" aria-label="ค้นหา">
  <% if (roleFilter) { %><input type="hidden" name="role" value="<%= roleFilter %>"><% } %>
  <% [['', 'ทั้งหมด'], ['member', 'สมาชิก'], ['admin', 'ผู้ดูแล']].forEach(([k, n]) => { %>
    <a class="chip <%= roleFilter === k ? 'on' : '' %>" href="/admin/users?role=<%= k %>&q=<%= encodeURIComponent(qText) %>">
      <%= n %>
    </a>
  <% }) %>
</form>

<div class="tw">
  <table class="tb">
    <thead>
      <tr>
        <th>ชื่อ</th>
        <th>ชื่อผู้ใช้</th>
        <th>อีเมล</th>
        <th>เบอร์โทร</th>
        <th>บทบาท</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% userList.forEach(u => {
        const fullName = u.first_name ? `${u.first_name} ${u.last_name || ''}`.trim() : (u.name || '-');
      %>
        <tr>
          <td>
            <div class="user-name-with-avatar">
              <%- include('../partials/user-avatar', { avatarName: fullName, avatarImage: u.profile_image, avatarHref: `/admin/users/${u.user_id}`, avatarSize: 36 }) %>
              <a href="/admin/users/<%= u.user_id %>"><b><%= fullName %></b></a>
              <% if (u.deleted_at) { %><span class="st no">ถูกแบน</span><% } %>
            </div>
          </td>
          <td class="mu"><%= u.username ? '@' + u.username : '-' %></td>
          <td class="mu"><%= u.email %></td>
          <td class="mu"><%= u.phone || '-' %></td>
          <td>
            <span class="st <%= u.role === 'admin' ? 'ok' : '' %>">
              <%= u.role === 'admin' ? 'ผู้ดูแล' : 'สมาชิก' %>
            </span>
          </td>
          <td class="admin-user-actions">
            <details class="admin-user-menu">
              <summary aria-label="เมนูผู้ใช้">⋮</summary>
              <div class="admin-user-menu-popover">
                <a href="/admin/users/<%= u.user_id %>">ดูโปรไฟล์</a>
                <% if (u.role === 'member' && String(u.user_id) !== String(currentUserId)) { %>
                  <form method="post" action="/admin/users/<%= u.user_id %>/<%= u.deleted_at ? 'unban' : 'ban' %>" onsubmit="return confirm('<%= u.deleted_at ? 'ยืนยันปลดแบนผู้ใช้นี้?' : 'ยืนยันแบนผู้ใช้นี้และปิดทีมของผู้ใช้?' %>')">
                    <input type="hidden" name="q" value="<%= qText %>">
                    <input type="hidden" name="role" value="<%= roleFilter %>">
                    <input type="hidden" name="page" value="<%= locals.pagination?.page || 1 %>">
                    <button type="submit" class="<%= u.deleted_at ? 'is-unban' : 'is-ban' %>"><%= u.deleted_at ? 'ปลดแบน' : 'แบน' %></button>
                  </form>
                <% } %>
              </div>
            </details>
          </td>
        </tr>
      <% }) %>
      <% if (!userList.length) { %>
        <tr><td colspan="6" class="mu" style="text-align:center;padding:28px">ไม่พบผู้ใช้</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination', { pagination: locals.pagination }) %>
