<%
  const s = locals.stats || {};
  const mockDb = locals.db || { users: [], teams: [], apps: [] };
  const totalUsers = s.total_users ?? mockDb.users.length;
  const totalTeams = s.total_teams ?? mockDb.teams.length;
  const totalReports = s.total_reports ?? 0;
  const pendingReports = s.pending_reports ?? 0;
%>

<h1>จัดการระบบ</h1>
<div class="admin-dashboard-grid">
  <a class="card admin-dashboard-card" href="/admin/users">
    <span class="admin-dashboard-label">ผู้ใช้ทั้งหมด</span>
    <strong><%= totalUsers %></strong>
    <span class="admin-dashboard-action">ดูรายชื่อผู้ใช้ →</span>
  </a>
  <a class="card admin-dashboard-card" href="/admin/teams">
    <span class="admin-dashboard-label">ทีมทั้งหมด</span>
    <strong><%= totalTeams %></strong>
    <span class="admin-dashboard-action">ดูรายละเอียดทีม →</span>
  </a>
  <a class="card admin-dashboard-card" href="/admin/reports">
    <span class="admin-dashboard-label">รายงานทั้งหมด</span>
    <strong><%= totalReports %></strong>
    <span class="admin-dashboard-action"><%= pendingReports %> รายการรอตรวจ →</span>
  </a>
</div>
