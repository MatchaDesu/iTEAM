<%
  const s = locals.stats;

  const stat = (n, l, c) => `<div class="card">
    <div class="mu" style="font-size:14px">${l}</div>
    <div style="font-size:32px;font-weight:700;line-height:1.2;color:var(${c || '--bl'})">${n}</div>
  </div>`;
%>

<h2>ภาพรวมระบบ</h2>
<div class="stats">
  <%- stat(s.total_users, 'ผู้ใช้ทั้งหมด') %>
  <%- stat(s.total_admins, 'ผู้ดูแลระบบ', '--wa') %>
  <%- stat(s.total_teams, 'ทีมทั้งหมด') %>
  <%- stat(s.total_categories, 'หมวดหมู่ทั้งหมด') %>
</div>
