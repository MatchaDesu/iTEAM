<%
  const teamList = Array.isArray(locals.teams) ? locals.teams : [];
  const catList = locals.categories || [];
  const qText = locals.q || '';
  const selectedCat = locals.cat || '';
%>

<h2>จัดการทีม</h2>
<form class="tools" method="get" action="/admin/teams">
  <input name="q" value="<%= qText %>" placeholder="ค้นหาชื่อทีม" aria-label="ค้นหา">
  <select name="cat" aria-label="หมวดหมู่" onchange="this.form.submit()">
    <option value="">ทุกหมวดหมู่</option>
    <% catList.forEach(c => {
      const cName = typeof c === 'object' ? c.category_name : c;
    %>
      <option value="<%= cName %>" <%= cName === selectedCat ? 'selected' : '' %>><%= cName %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn sec sm">ค้นหา</button>
</form>

<div class="tw">
  <style>
    .admin-team-row { cursor: pointer; }
    .admin-team-row:hover { background: rgba(37, 99, 235, .06); }
    .admin-team-row:focus-visible { outline: 2px solid var(--bl); outline-offset: -2px; }
  </style>
  <table class="tb">
    <thead>
      <tr>
        <th>ชื่อทีม</th>
        <th>หมวดหมู่</th>
        <th>รายละเอียด</th>
        <th>จัดการ</th>
      </tr>
    </thead>
    <tbody>
      <% teamList.forEach(t => {
        const tId = t.team_id;
        const tName = t.team_name;
        const tDesc = t.description || '';
      %>
        <tr class="admin-team-row" data-team-url="/teams/<%= tId %>" tabindex="0" aria-label="ดูรายละเอียดทีม <%= tName %>">
          <td><b><a href="/teams/<%= tId %>" style="text-decoration:none;color:inherit"><%= tName %></a></b></td>
          <td><%= t.category_name || 'ไม่ระบุ' %></td>
          <td class="mu"><%= tDesc %></td>
          <td>
            <form method="post" action="/admin/teams/<%= tId %>/delete"
                  onsubmit="return confirm('ลบทีมนี้ถาวร?')">
              <button type="submit" class="btn no sm">ลบทีม</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!teamList.length) { %>
        <tr><td colspan="4" class="mu" style="text-align:center;padding:28px">ไม่พบทีม</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
  document.querySelectorAll('.admin-team-row').forEach(row => {
    const openTeam = event => {
      if (event.target.closest('a, button, form, input, select, textarea')) return;
      window.location.href = row.dataset.teamUrl;
    };
    row.addEventListener('click', openTeam);
    row.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        window.location.href = row.dataset.teamUrl;
      }
    });
  });
</script>
