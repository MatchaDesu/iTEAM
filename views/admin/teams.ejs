<% const SP={approved:['ok','อนุมัติแล้ว'], pending:['pending','รอตรวจ'], removed:['no','ถูกถอด']}; const
  pc=db.teams.filter(t=> t.status === 'pending').length;
  %>
  <h2>จัดการทีม</h2>
  <form class="tools" method="get">
    <input name="q" value="<%= q %>" placeholder="ค้นหาชื่อทีมหรือหัวหน้าทีม" aria-label="ค้นหา">
    <select name="cat" aria-label="หมวดหมู่" onchange="this.form.submit()">
      <option value="">ทุกหมวดหมู่</option>
      <% cats.forEach(c=> { %><option <%=c===cat?'selected':'' %>><%= c %>
        </option>
        <% }) %>
    </select>
    <input type="hidden" name="status" value="<%= st %>">
    <button class="btn sec sm">ค้นหา</button>
  </form>
  <div class="tools">
    <% [['','ทั้งหมด'],['pending','รอตรวจ' + (pc ? ` (${pc})` : ''
      )],['approved','อนุมัติแล้ว'],['removed','ถูกถอด']].forEach(([k,n])=> { %>
      <a class="chip <%= st===k?'on':'' %>"
        href="/admin/teams?status=<%= k %>&cat=<%= encodeURIComponent(cat) %>&q=<%= encodeURIComponent(q) %>">
        <%= n %>
      </a>
      <% }) %>
  </div>
  <div class="tw">
    <table class="tb">
      <thead>
        <tr>
          <th>ทีม</th>
          <th>หัวหน้าทีม</th>
          <th>สมาชิก</th>
          <th>โพสต์รับสมัคร</th>
          <th>การแสดงผล</th>
          <th>จัดการ</th>
        </tr>
      </thead>
      <tbody>
        <% teams.forEach(t=> { %>
          <tr>
            <td><b>
                <%= t.name %>
              </b>
              <div class="mu" style="font-size:13px">
                <%= t.cat %>
              </div>
            </td>
            <td>
              <%= uname(t.leader) %>
            </td>
            <td>
              <%= t.members.length %>/<%= t.max %>
            </td>
            <td>
              <%= t.title %>
                <div><span class="st <%= SP[t.status][0] %>">
                    <%= SP[t.status][1] %>
                  </span></div>
                <% if (t.reason) { %>
                  <div class="mu" style="font-size:13px">เหตุผลที่ถอด: <%= t.reason %>
                  </div>
                  <% } %>
            </td>
            <td><span class="st <%= t.hidden?'no':'ok' %>">
                <%= t.hidden ? 'ซ่อนอยู่' : 'แสดงอยู่' %>
              </span></td>
            <td>
              <div class="acts">
                <% if (t.status !=='approved' ) { %>
                  <form method="post" action="/admin/posts/<%= t.id %>/approve"><button
                      class="btn <%= t.status==='removed'?'sec':'' %> sm">
                      <%= t.status==='removed' ? 'คืนโพสต์' : 'อนุมัติ' %>
                    </button></form>
                  <% } %>
                    <% if (t.status !=='removed' ) { %>
                      <details>
                        <summary class="btn no sm" style="list-style:none">
                          <%= t.status==='pending' ? 'ปฏิเสธ' : 'ถอดโพสต์' %>
                        </summary>
                        <form method="post" action="/admin/posts/<%= t.id %>/remove" class="acts"
                          style="margin-top:6px">
                          <input name="reason" placeholder="เหตุผล (ส่งให้หัวหน้าทีม)" required style="width:190px"
                            aria-label="เหตุผล"><button class="btn no sm">ยืนยัน</button>
                        </form>
                      </details>
                      <% } %>
                        <form method="post" action="/admin/teams/<%= t.id %>/hide"><button class="btn sec sm">
                            <%= t.hidden ? 'แสดงทีม' : 'ซ่อนทีม' %>
                          </button></form>
                        <form method="post" action="/admin/teams/<%= t.id %>/delete"
                          onsubmit="return confirm('ลบทีมนี้ถาวร?')"><button class="btn no sm">ลบ</button></form>
              </div>
            </td>
          </tr>
          <% }) %>
            <% if (!teams.length) { %>
              <tr>
                <td colspan="6" class="mu" style="text-align:center;padding:28px">ไม่พบทีม</td>
              </tr>
              <% } %>
      </tbody>
    </table>
  </div>