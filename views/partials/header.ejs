<%
  // ===== Data Adapter: รองรับข้อมูลจากแอปหลัก =====
  const isMock = Boolean(locals.db);
  const curUser = locals.user || null;

  const displayName = curUser
    ? (curUser.first_name
        ? `${curUser.first_name} ${curUser.last_name || ''}`.trim()
        : (curUser.name || curUser.username || 'สมาชิก'))
    : '';
  const subLabel = curUser
    ? (curUser.username ? `@${curUser.username}` : (curUser.email || ''))
    : '';
  const avatarInitial = displayName ? Array.from(displayName)[0].toUpperCase() : 'U';

  const rawAvatar = curUser?.profile_image || '';
  const isDefaultAvatar = !rawAvatar
    || rawAvatar.includes('profile-anonymous')
    || rawAvatar.includes('profile_anonymous');

  const currentPath = locals.currentPath || '';
  const routeTab = curUser?.role === 'admin'
    ? (currentPath === '/admin' ? 'dash'
      : currentPath.startsWith('/admin/users') ? 'users'
      : currentPath.startsWith('/admin/teams') ? 'teams'
      : currentPath.startsWith('/admin/reports') ? 'reports' : '')
    : (currentPath === '/' ? 'home'
      : currentPath.startsWith('/teams') ? 'search'
      : currentPath.startsWith('/about') ? 'about'
      : currentPath.startsWith('/guide') ? 'guide'
      : currentPath.startsWith('/notifications') ? 'notes'
      : currentPath.startsWith('/favorites') ? 'favorites' : '');
  const activeTab = routeTab || locals.active || '';
  const isPath = (path) => currentPath === path || currentPath.startsWith(`${path}/`);
  const unreadCount = Number(locals.unread || 0);
  const pendingCount = Number(locals.pendingPosts || 0);

  // เส้นทางที่รองรับทั้งโหมดพรีวิวและเซิร์ฟเวอร์หลัก
  const loginUrl = isMock ? '/login' : '/auth/login';
  const signupUrl = isMock ? '/register' : '/auth/signup';
  const appsUrl = isMock ? '/applications' : '/application';

  // ลิงก์เมนูหลักฝั่งซ้าย (วางต่อจากโลโก้ตามภาพตัวอย่าง)
  const mainLinks = curUser && curUser.role === 'admin'
    ? [
        ['dash', '/admin', 'ภาพรวม'],
        ['users', '/admin/users', 'จัดการผู้ใช้'],
        ['teams', '/admin/teams', 'จัดการทีม'],
        ['reports', '/admin/reports', 'บันทึกรายงาน']
      ]
    : [
        ['home', '/', 'หน้าแรก'],
        ['search', '/teams', 'ค้นหาทีม'],
        ['about', '/about', 'เกี่ยวกับเรา'],
        ['guide', '/guide', 'คู่มือการใช้งาน']
      ];
%>

<header>
  <div class="bar">
    <!-- โลโก้ -->
    <a class="logo" href="<%= curUser && curUser.role === 'admin' ? '/admin' : '/' %>">
      <i></i><span>i<em>TEAM</em></span>
    </a>

    <!-- เมนูหลักฝั่งซ้าย -->
    <nav class="nav-main" aria-label="เมนูหลัก">
      <% mainLinks.forEach(([k, href, label]) => { %>
        <a href="<%= href %>" class="<%= activeTab === k ? 'on' : '' %>">
          <%= label %>
          <% if (k === 'teams' && pendingCount > 0) { %>
            <span class="dot"><%= pendingCount %></span>
          <% } %>
        </a>
      <% }) %>
    </nav>

    <!-- กลุ่มไอคอนและโปรไฟล์ฝั่งขวา -->
    <div class="nav-right">
      

      <% if (curUser) { %>
        <% if (curUser.role !== 'admin') { %>
          <!-- ไอคอนแจ้งเตือน -->
          <a href="/notifications" class="nav-icon-btn <%= activeTab === 'notes' ? 'on' : '' %>" title="การแจ้งเตือน" aria-label="การแจ้งเตือน">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span id="notificationBadge" class="nav-badge" style="display:<%= unreadCount > 0 ? 'inline-flex' : 'none' %>"><%= unreadCount > 9 ? '9+' : unreadCount %></span>
          </a>
        <% } %>

        <!-- ปุ่มโปรไฟล์วงกลม + เมนูดรอปดาวน์ -->
        <div class="nav-user" id="navUserWrap">
          <button
            type="button"
            class="nav-avatar"
            onclick="toggleNavMenu(event)"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="เมนูบัญชีผู้ใช้"
            title="<%= displayName %>">
            <% if (!isDefaultAvatar) { %>
              <img src="<%= rawAvatar %>" alt="<%= displayName %>" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">
              <span style="display:none"><%= avatarInitial %></span>
            <% } else { %>
              <span><%= avatarInitial %></span>
            <% } %>
          </button>

          <div class="nav-menu" id="navUserMenu" hidden>
            <div class="nav-menu-head">
              <div style="font-weight:600;color:var(--ink)"><%= displayName %></div>
              <% if (subLabel) { %>
                <div class="mu" style="font-size:13px"><%= subLabel %></div>
              <% } %>
            </div>

            <% if (curUser.role === 'admin') { %>
              <a class="<%= isPath('/admin') && currentPath === '/admin' ? 'on' : '' %>" href="/admin">แดชบอร์ดผู้ดูแล</a>
              <a class="<%= isPath('/admin/users') ? 'on' : '' %>" href="/admin/users">จัดการผู้ใช้</a>
              <a class="<%= isPath('/admin/teams') ? 'on' : '' %>" href="/admin/teams">จัดการทีม</a>
              <a class="<%= isPath('/admin/reports') ? 'on' : '' %>" href="/admin/reports">บันทึกรายงาน</a>
            <% } else { %>
              <a class="<%= isPath('/profile') ? 'on' : '' %>" href="/profile">โปรไฟล์ของฉัน</a>
              <a class="<%= isPath('/leader/teams') && currentPath !== '/leader/teams/new' ? 'on' : '' %>" href="/leader/teams">ทีมของฉัน</a>
              <a class="<%= isPath('/application') ? 'on' : '' %>" href="<%= appsUrl %>">ใบสมัครของฉัน</a>
              <a class="<%= currentPath === '/leader/teams/new' ? 'on' : '' %>" href="/leader/teams/new">+ สร้างทีมใหม่</a>
            <% } %>
            <% if (curUser.role !== 'admin') { %><a class="<%= isPath('/favorites') ? 'on' : '' %>" href="/favorites">ทีมที่บันทึกไว้</a><% } %>

            <div class="nav-menu-sep"></div>

            <form method="post" action="/auth/logout">
              <button type="submit" class="danger">ออกจากระบบ</button>
            </form>
          </div>
        </div>

      <% } else { %>
        <!-- กรณีผู้เยี่ยมชม (Guest) -->
        <a class="btn sec sm" href="<%= loginUrl %>">เข้าสู่ระบบ</a>
        <a class="btn sm" href="<%= signupUrl %>">สมัครสมาชิก</a>
      <% } %>
    </div>
  </div>
</header>

<script>
  function toggleNavMenu(e) {
    e.stopPropagation();
    const menu = document.getElementById('navUserMenu');
    const btn = e.currentTarget;
    if (!menu) return;
    const isHidden = menu.hasAttribute('hidden');
    if (isHidden) {
      menu.removeAttribute('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      menu.setAttribute('hidden', '');
      btn.setAttribute('aria-expanded', 'false');
    }
  }

  document.addEventListener('click', (e) => {
    const wrap = document.getElementById('navUserWrap');
    const menu = document.getElementById('navUserMenu');
    if (wrap && menu && !wrap.contains(e.target)) {
      menu.setAttribute('hidden', '');
      wrap.querySelector('.nav-avatar')?.setAttribute('aria-expanded', 'false');
    }

    document.querySelectorAll('.admin-user-menu[open]').forEach((userMenu) => {
      if (!userMenu.contains(e.target)) userMenu.removeAttribute('open');
    });
    const summary = e.target.closest('.admin-user-menu > summary');
    if (summary) {
      const userMenu = summary.parentElement;
      requestAnimationFrame(() => {
        if (!userMenu.open) return;
        const popover = userMenu.querySelector('.admin-user-menu-popover');
        if (!popover) return;
        const rect = summary.getBoundingClientRect();
        const left = Math.max(8, Math.min(rect.right - popover.offsetWidth, window.innerWidth - popover.offsetWidth - 8));
        const below = rect.bottom + popover.offsetHeight + 8 <= window.innerHeight;
        const top = below ? rect.bottom + 6 : Math.max(8, rect.top - popover.offsetHeight - 6);
        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
      });
    }
  });

  const closeAdminUserMenus = () => {
    document.querySelectorAll('.admin-user-menu[open]').forEach((userMenu) => userMenu.removeAttribute('open'));
  };
  window.addEventListener('scroll', closeAdminUserMenus, true);
  window.addEventListener('resize', closeAdminUserMenus);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const menu = document.getElementById('navUserMenu');
      if (menu) menu.setAttribute('hidden', '');
    }
  });
</script>
