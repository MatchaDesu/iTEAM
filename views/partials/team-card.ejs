<%
  const teamId = t.team_id ?? t.id;
  const teamName = t.team_name ?? t.name ?? '';
  const teamCat = t.category_name ?? t.cat ?? 'ทั่วไป';
  const teamDesc = t.description ?? t.desc ?? '';
  const teamRoles = Array.isArray(t.roles) ? t.roles : [];
  const memberCount = Array.isArray(t.members) ? t.members.length : (t.member_count ?? null);
  const teamMax = t.max_members ?? t.max ?? null;
  const favoriteTeamIds = locals.favoriteTeamIds || [];
  const isFavorite = favoriteTeamIds.some(id => String(id) === String(teamId));
  const favoriteReturnTo = locals.favoriteReturnTo || '/teams';
%>

<div class="card team-card">
  <a class="team-card-open-link" href="/teams/<%= teamId %>" aria-label="ดูรายละเอียดทีม <%= teamName %>"></a>
  <% if (locals.user) { %>
    <form class="team-card-favorite" method="post" action="/favorites/<%= teamId %>/<%= isFavorite ? 'remove' : 'save' %>">
      <input type="hidden" name="returnTo" value="<%= favoriteReturnTo %>">
      <button
        type="submit"
        class="team-favorite-btn <%= isFavorite ? 'is-favorite' : '' %>"
        aria-label="<%= isFavorite ? 'นำออกจากทีมโปรด' : 'บันทึกเป็นทีมโปรด' %>"
        title="<%= isFavorite ? 'นำออกจากทีมโปรด' : 'บันทึกเป็นทีมโปรด' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="flag-pole" d="M5 21V4"></path>
          <path class="flag-shape" d="M6 5c4-2 8 3 13 0v10c-5 3-9-2-13 0z"></path>
        </svg>
      </button>
    </form>
  <% } %>
  <div style="display:flex;justify-content:space-between;gap:8px;padding-right:<%= locals.user ? '38px' : '0' %>">
    <div>
      <span class="tag"><%= teamCat %></span>
      <h3><%= teamName %></h3>
    </div>
  </div>
  <div class="mu" style="font-size:15px"><%= teamDesc %></div>
  <% if (teamRoles.length) { %>
    <div>
      <% teamRoles.forEach(r => { %><span class="tag"><%= r %></span><% }) %>
    </div>
  <% } %>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:auto">
    <span class="mu" style="font-size:14px">
      <% if (memberCount !== null) { %>
        สมาชิก <%= memberCount %><%= teamMax ? '/' + teamMax : '' %> คน
      <% } else { %>
        ดูรายละเอียดทีม
      <% } %>
    </span>
    <a class="btn sm" href="/teams/<%= teamId %>">ดูรายละเอียด</a>
  </div>
</div>
