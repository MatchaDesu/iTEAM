<%
  const rawTeam = locals.team || {};
  const valName = rawTeam.team_name || '';
  const valDesc = rawTeam.description || '';
  const valCatId = rawTeam.category_id ?? '';
  const catList = locals.categories || [];
%>

<label for="team_name">ชื่อทีม</label>
<input id="team_name" name="team_name" maxlength="100" value="<%= valName %>" required>

<label for="category_id">หมวดหมู่</label>
<select id="category_id" name="category_id">
  <option value="">-- ไม่ระบุหมวดหมู่ --</option>
  <% catList.forEach(c => {
    const cId = c.category_id;
    const cName = c.category_name;
    const isSel = valCatId && String(cId) === String(valCatId);
  %>
    <option value="<%= cId %>" <%= isSel ? 'selected' : '' %>><%= cName %></option>
  <% }) %>
</select>

<label for="description">รายละเอียดทีม</label>
<textarea id="description" name="description" rows="4" required><%= valDesc %></textarea>
