<%
  // ===== 1. Data Adapter: รองรับทั้งข้อมูลจาก preview.js และ PostgreSQL =====
  const isMock = Boolean(locals.db);
  const t = locals.team || locals.t || {};
  const tId = t.team_id ?? t.id;
  const tName = t.team_name ?? t.name ?? 'ไม่ระบุชื่อทีม';
  const tCat = t.category_name ?? t.cat ?? '';
  const tDesc = t.description ?? t.desc ?? '';
  const tMax = Number(t.max_members ?? t.max ?? 5);
  const tStatus = t.status || 'open';
  const leaderId = t.created_by ?? t.leader ?? null;
  const adminReadOnly = Boolean(locals.adminReadOnly);
  const userProfileUrl = id => adminReadOnly ? `/admin/users/${id}` : `/users/${id}`;
  const teamListUrl = adminReadOnly ? '/admin/teams' : '/teams';

  const curUser = locals.user || null;
  const curUserId = curUser ? (curUser.user_id ?? curUser.id) : null;
  const isLeader = Boolean(curUserId && leaderId && String(curUserId) === String(leaderId));

  // แปลงรายชื่อสมาชิกให้เป็นรูปแบบเดียวกันทั้งจาก PostgreSQL และ preview.js
  const mockUsers = Array.isArray(locals.db?.users) ? locals.db.users : [];
  const rawMembers = Array.isArray(locals.members)
    ? locals.members
    : (Array.isArray(t.members) ? t.members : []);

  const memberList = rawMembers.map(m => {
    if (m && typeof m === 'object') {
      const fullName = m.first_name
        ? `${m.first_name} ${m.last_name || ''}`.trim()
        : (m.name || m.username || 'สมาชิก');
      return {
        id: m.user_id ?? m.id,
        name: fullName,
        username: m.username || '',
        profile_image: m.profile_image || '',
        skills: m.skills || '',
        role: m.team_role || (String(m.user_id ?? m.id) === String(leaderId) ? 'leader' : 'member')
      };
    }
    const found = mockUsers.find(u => String(u.id) === String(m));
    return {
      id: m,
      name: found?.name || 'สมาชิก',
      username: found?.username || '',
      profile_image: found?.profile_image || '',
      skills: found?.skills || '',
      role: String(m) === String(leaderId) ? 'leader' : 'member'
    };
  });

  const isMember = Boolean(
    curUserId && memberList.some(m => String(m.id) === String(curUserId))
  );

  // ตรวจสอบสถานะการส่งคำขอของผู้ใช้ปัจจุบัน
  const mockApps = Array.isArray(locals.db?.apps) ? locals.db.apps : [];
  const myApp = locals.myApplication
    || (curUserId ? mockApps.find(a => String(a.team) === String(tId) && String(a.user) === String(curUserId)) : null);
  const myApplicationDetails = locals.myApplicationDetails || myApp;

  const canApply = Boolean(curUser && !isLeader && !isMember && !myApp && tStatus === 'open' && memberList.length < tMax);
  const loginUrl = isMock ? '/login' : '/auth/login';
%>

<div class="pf-wrap">
  <div>
    <a class="btn sec sm" href="<%= teamListUrl %>">← <%= adminReadOnly ? 'กลับไปหน้าทีมทั้งหมด' : 'กลับไปหน้าค้นหาทีม' %></a>
  </div>

  <!-- 1. การ์ดหัวข้อทีม -->
  <div class="card team-detail-card" style="padding:0;overflow:hidden">
    <% if (curUser && !adminReadOnly) { %>
      <form class="team-card-favorite team-detail-favorite" method="post" action="/favorites/<%= tId %>/<%= isFavorite ? 'remove' : 'save' %>">
        <input type="hidden" name="returnTo" value="/teams/<%= tId %>">
        <button
          type="submit"
          class="team-favorite-btn <%= isFavorite ? 'is-favorite' : '' %>"
          aria-label="<%= isFavorite ? 'นำออกจากทีมโปรด' : 'บันทึกเป็นทีมโปรด' %>"
          title="<%= isFavorite ? 'นำออกจากทีมโปรด' : 'บันทึกเป็นทีมโปรด' %>">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="flag-pole" d="M5 21V4"></path>
            <path class="flag-shape" d="M6 5c4-2 8 3 13 0v10c-5 3-9-2-13 0z"></path>
          </svg>
        </button>
      </form>
    <% } %>
    <!-- แบนเนอร์ด้านบน -->
    <div style="position:relative;background:linear-gradient(180deg,var(--sk) 0%,#eaf2ff 100%);padding:44px 24px;display:grid;place-items:center;border-bottom:1px solid var(--ln)">
      <div style="position:absolute;top:16px;left:16px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <% if (tCat) { %>
          <span class="tag" style="background:var(--sf);margin:0"><%= tCat %></span>
        <% } %>
        <span class="st <%= tStatus === 'open' ? 'ok' : 'no' %>">
          <%= tStatus === 'open' ? 'เปิดรับสมัคร' : 'ปิดรับสมัคร' %>
        </span>
      </div>

      <div class="logo" style="font-size:28px;pointer-events:none">
        <i style="width:34px;height:34px;border-radius:10px"></i>
        <span>i<em style="font-style:normal;color:var(--ink)">TEAM</em></span>
      </div>
    </div>

    <!-- ข้อมูลทีมด้านล่างแบนเนอร์ -->
    <div style="padding:24px 28px;display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap">
      <div style="flex:1;min-width:260px">
        <h1 style="margin:0 0 8px;font-size:clamp(22px,3.5vw,28px)"><%= tName %></h1>
        <div class="mu" style="font-size:14px">
          หมวดหมู่: <%= tCat || 'ไม่ระบุ' %> • สมาชิก <%= memberList.length %>/<%= tMax %> คน
        </div>
      </div>

      <!-- ปุ่มส่งคำขอ / จัดการทีม และ ติดต่อหัวหน้าทีม -->
      <div style="display:flex;flex-direction:column;gap:8px;min-width:170px">
        <% if (!adminReadOnly) { %>
          <% if (isLeader) { %>
          <a class="btn" style="justify-content:center" href="/leader/teams?team=<%= tId %>">จัดการทีม</a>
        <% } else if (myApplicationDetails?.status === 'pending') { %>
          <span class="st <%= myApplicationDetails.status === 'approved' ? 'accepted' : myApplicationDetails.status %>">
            รอพิจารณา
          </span>
          <a class="btn sec" style="justify-content:center" href="/application/<%= myApplicationDetails.application_id %>">ดูรายละเอียดคำขอที่ส่ง</a>
        <% } else if (isMember) { %>
          <% if (myApplicationDetails) { %>
            <span class="st accepted">ได้รับการตอบรับ</span>
            <a class="btn sec" style="justify-content:center" href="/application/<%= myApplicationDetails.application_id %>">ดูรายละเอียดคำขอที่ส่ง</a>
          <% } %>
        <% } else { %>
          <% if (myApplicationDetails) { %>
            <span class="st rejected">ไม่ผ่าน</span>
            <a class="btn sec" style="justify-content:center" href="/application/<%= myApplicationDetails.application_id %>">ดูรายละเอียดคำขอเดิม</a>
          <% } %>
          <% if (!curUser) { %>
            <a class="btn" style="justify-content:center" href="<%= loginUrl %>">ส่งคำขอ</a>
          <% } else if (canApply) { %>
            <a class="btn" style="justify-content:center" href="/teams/<%= tId %>/apply">ส่งคำขอ</a>
          <% } else { %>
            <button type="button" class="btn sec" style="justify-content:center;cursor:not-allowed" disabled>ปิดรับสมัคร</button>
          <% } %>
          <% } %>
        <% } %>

        <% if (leaderId && !adminReadOnly) { %>
          <a class="btn sec" style="justify-content:center" href="/users/<%= leaderId %>">
            ✉ ติดต่อหัวหน้าทีม
          </a>
        <% } %>
        <% if (curUser && curUser.role !== 'admin' && !isLeader && !isMember) { %>
          <%- include('../partials/report-button', { reportTargetType: 'team', reportTargetId: tId }) %>
        <% } %>
      </div>
    </div>
  </div>

  <section class="card team-description-card">
    <h2>คำอธิบายโปรเจกต์</h2>
    <p class="team-description-text"><%= tDesc || 'ไม่มีรายละเอียดทีม' %></p>
  </section>

  <!-- 2. รายชื่อสมาชิกในทีม -->
  <div class="card">
    <h2 style="margin:0">
      สมาชิกในทีม
      <span class="mu" style="font-size:15px;font-weight:400">(<%= memberList.length %>/<%= tMax %> คน)</span>
    </h2>

    <% if (memberList.length) { %>
      <div class="stack">
        <% memberList.forEach(m => { %>
          <div class="pf-team-row">
            <div style="display:flex;align-items:center;gap:12px;min-width:0;flex:1">
              <%- include('../partials/user-avatar', {
                avatarName: m.name,
                avatarImage: m.profile_image,
                avatarHref: userProfileUrl(m.id),
                avatarSize: 40
              }) %>
              <div style="min-width:0">
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                  <a href="<%= userProfileUrl(m.id) %>" class="pf-team-title"><%= m.name %></a>
                  <% if (m.role === 'leader') { %>
                    <span class="st ok">หัวหน้าทีม</span>
                  <% } else { %>
                    <span class="tag" style="margin:0">สมาชิก</span>
                  <% } %>
                </div>
                <% if (m.skills) { %>
                  <div class="mu pf-team-desc"><%= m.skills %></div>
                <% } %>
              </div>
            </div>

            <a class="btn sec sm" href="<%= userProfileUrl(m.id) %>">ดูโปรไฟล์</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="pf-empty-sub mu">ยังไม่มีข้อมูลสมาชิกในทีม</div>
    <% } %>
  </div>
</div>

