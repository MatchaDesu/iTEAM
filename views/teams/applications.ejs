<h2>ใบสมัครของฉัน</h2>
<% if (apps.length) { %>
  <div class="stack">
    <% apps.forEach(a=> { const t = db.teams.find(x => x.id === a.team); %>
      <div class="card row">
        <div>
          <h3><a href="/teams/<%= t.id %>" style="color:inherit;text-decoration:none">
              <%= t.name %>
            </a></h3>
          <div class="mu" style="font-size:14px">
            <%= a.msg || 'ไม่มีข้อความ' %>
          </div>
        </div>
        <div class="acts">
          <span class="st <%= a.status %>">
            <%= ST[a.status] %>
          </span>
          <% if (a.status==='pending' ) { %>
            <form method="post" action="/applications/<%= a.id %>/cancel"><button class="btn no sm">ยกเลิก</button>
            </form>
            <% } %>
        </div>
      </div>
      <% }) %>
  </div>
  <% } else { %>
    <div class="empty">ยังไม่มีใบสมัคร เริ่มจากค้นหาทีมที่สนใจ</div>
    <% } %>