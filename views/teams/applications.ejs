<%
  const appList = locals.applications || locals.apps || [];
  const mockTeams = Array.isArray(locals.db?.teams) ? locals.db.teams : [];
  const statusMap = Object.assign(
    { pending: 'รอพิจารณา', approved: 'ได้รับการตอบรับ', accepted: 'ได้รับการตอบรับ', rejected: 'ไม่ผ่าน' },
    locals.ST || {}
  );
%>

<h2>ใบสมัครของฉัน</h2>
<% if (appList.length) { %>
  <div class="stack">
    <% appList.forEach(a => {
      const appId = a.application_id ?? a.id;
      const tId = a.team_id ?? a.team;
      const foundTeam = mockTeams.find(x => x.id === tId);
      const tName = a.team_name ?? foundTeam?.name ?? 'ไม่พบชื่อทีม';
      const msgText = a.message ?? a.msg ?? '';
      const badgeClass = a.status === 'approved' ? 'accepted' : a.status;
    %>
      <div class="card row app-card">
        <div>
          <h3><a class="app-card-link" href="/teams/<%= tId %>"><%= tName %></a></h3>
          <div class="mu" style="font-size:14px"><%= msgText || 'ไม่มีข้อความ' %></div>
        </div>
        <div class="acts app-card-actions">
          <span class="st <%= badgeClass %>"><%= statusMap[a.status] || a.status %></span>
          <% if (a.status === 'pending') { %>
            <form method="post" action="/application/<%= appId %>/cancel">
              <button type="submit" class="btn no sm">ยกเลิก</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty">ยังไม่มีใบสมัคร เริ่มจากค้นหาทีมที่สนใจ</div>
<% } %>
