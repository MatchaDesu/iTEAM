<%
  const noteList = locals.list || locals.notifications || [];
%>

<h2>การแจ้งเตือน</h2>
<% if (noteList.length) { %>
  <div class="stack">
    <% noteList.forEach(n => { %>
      <div class="card" style="<%= n.read ? '' : 'border-color:var(--bl)' %>">
        <%= n.text || n.message %>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty">ยังไม่มีการแจ้งเตือน</div>
<% } %>