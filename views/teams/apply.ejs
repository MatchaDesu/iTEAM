<%
  const t = locals.team;
  const teamId = t.team_id;
%>

<div class="pf-wrap">
  <a class="btn sec sm" href="/teams/<%= teamId %>">← กลับไปหน้าทีม</a>

  <section class="card" style="max-width:720px;margin:0 auto">
    <span class="tag"><%= t.category_name || 'ทั่วไป' %></span>
    <h1 style="font-size:28px;margin-top:8px">สมัครเข้าร่วมทีม <%= t.team_name %></h1>
    <p class="mu"><%= t.description %></p>
    <p class="mu" style="font-size:14px">สมาชิก <%= t.member_count %>/<%= t.max_members %> คน</p>

    <form method="post" action="/teams/<%= teamId %>/apply">
      <label for="applyMsg">ข้อความแนะนำตัวถึงหัวหน้าทีม</label>
      <textarea
        id="applyMsg"
        name="message"
        rows="5"
        maxlength="2000"
        placeholder="แนะนำทักษะ ความถนัด หรือเหตุผลที่อยากเข้าร่วมทีมนี้..."
        required></textarea>
      <div style="display:flex;gap:10px;margin-top:14px">
        <button type="submit" class="btn">ส่งคำขอ</button>
        <a class="btn sec" href="/teams/<%= teamId %>">ยกเลิก</a>
      </div>
    </form>
  </section>
</div>
